# Dependencies and caches
node_modules/
__pycache__/
*.pyc
.wrangler/
.expo/
.eslintcache
*.tsbuildinfo

# Build output (Expo prebuild is generated: Continuous Native Generation)
dist/
# desktop/dist/ (electron-builder output) is covered by dist/
web-build/
ios/
android/
*.ipa
*.apk
*.aab
*.dmg

# Server state: databases, keys, uploads, recordings and logs
server/data/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-*
*.log
logs/

# Real configuration from an installation. Commit examples instead (*.example, *.example.json).
server/config.json
server/projects.json
push.json
mail.json
relay.json
.dev.vars
.dev.vars.*
.env
.env.*
!.env.example

# Credentials and signing material
.certs/
*.p8
*.p12
*.pfx
*.pem
*.key
*.jks
*.keystore
*.mobileprovision
*.provisionprofile
*.cer
service-account*.json
*-service-account.json
google-services.json
GoogleService-Info.plist
# The Expo code-signing certificate is public (app.json codeSigningCertificate);
# its private key must never be committed.
!app/certs/certificate.pem

# Local files
.DS_Store
.vscode/
.idea/
*.swp
