{
  "hosting": {
    "site": "servant-desktop",
    "public": "dist/downloads",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" },
          { "key": "Content-Security-Policy", "value": "default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" }
        ]
      },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
      { "source": "/SHA256SUMS", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
    ]
  }
}
