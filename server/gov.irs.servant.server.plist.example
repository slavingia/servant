<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>gov.irs.servant.server</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/Users/sahil-irs/servant/server/run.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/sahil-irs</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/sahil-irs/servant/server/data/server.log</string>
  <key>StandardErrorPath</key><string>/Users/sahil-irs/servant/server/data/server.log</string>
</dict>
</plist>
