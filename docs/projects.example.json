      "id": "servant",
      "name": "Servant",
      "description": "The team chat app: phone app, server, agent bridge and Mac app",
      "repo": "slavingia/servant",
      "visibility": "private",
      "path": "~/servant",
      "workflow": "main",
      "rules": [
        "Iterate on main with small follow-up commits. Never rewrite pushed history.",
        "Run the server tests and the app's tsc and npm test before pushing.",
        "Deploy the API with server/deploy.mjs and the worker with worker-swap.sh."
      ],
      "owners": [
        "pat-example"
      ],
      "access": {
        "merge": [
          "pat-example"
        ],
        "write": [
          "jo-park"
        ],
        "read": []
      }
    },
