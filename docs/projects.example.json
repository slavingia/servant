      "visibility": "private",
      "path": "~/prototypes",
      "pages": "https://example-org.github.io/prototypes/",
      "workflow": "main",
      "rules": [
        "Work directly on main, each prototype in a clearly named folder. No branches or pull requests unless asked.",
        "Public information and made-up sample data only.",
        "Run the repo's checks before pushing.",
        "Prototyping chats work only inside their own folder."
      ],
      "owners": [
        "pat-example"
