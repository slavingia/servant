{
  "expo": {
    "name": "Servant",
    "slug": "servant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gov.irs.servant",
      "infoPlist": {
        "NSCameraUsageDescription": "Servant uses the camera for invite codes and meeting video."
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "28"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#112E51",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "gov.irs.servant",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "googleServicesFile": "./google-services.json",
      "versionCode": 28
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-system-ui",
      [
        "expo-camera",
        {
          "cameraPermission": "Servant uses the camera to read invite codes.",
          "microphonePermission": "Servant uses the microphone so you can dictate messages.",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          },
          "android": {
            "extraProguardRules": "-keep class org.webrtc.** { *; }\n-dontwarn org.webrtc.**"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0071BC",
          "defaultChannel": "messages",
          "mode": "production"
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Servant lets you choose photos and videos to attach to messages, and a profile photo.",
          "cameraPermission": "Servant uses the camera to read invite codes.",
          "microphonePermission": "Servant uses the microphone so you can dictate messages."
        }
      ],
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Servant uses the microphone so you can dictate messages.",
          "speechRecognitionPermission": "Servant turns your speech into text in the message box.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.samsung.android.bixby.agent"
          ]
        }
      ],
      "expo-web-browser",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Servant uses the camera for invite codes and meeting video.",
          "microphonePermission": "Servant uses the microphone for dictation and meetings."
        }
      ],
      "expo-updates"
    ],
    "scheme": "servant",
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "nativeVersion"
    },
    "updates": {
      "url": "https://servant.invalid/ota/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      },
      "enabled": false
    }
  }
}
