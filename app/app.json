{
  "expo": {
    "name": "Servant",
    "slug": "servant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gov.irs.servant",
      "infoPlist": {
        "NSCameraUsageDescription": "Servant uses the camera to read invite codes."
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "16"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#112E51",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "gov.irs.servant",
      "googleServicesFile": "./google-services.json",
      "versionCode": 16
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-system-ui",
      [
        "expo-camera",
        {
          "cameraPermission": "Servant uses the camera to read invite codes.",
          "microphonePermission": "Servant uses the microphone so you can dictate messages.",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0071BC",
          "defaultChannel": "messages",
          "mode": "production"
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Servant lets you choose photos and videos to attach to messages.",
          "cameraPermission": false,
          "microphonePermission": "Servant uses the microphone so you can dictate messages."
        }
      ],
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Servant uses the microphone so you can dictate messages.",
          "speechRecognitionPermission": "Servant turns your speech into text in the message box.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.tts", "com.samsung.android.bixby.agent"]
        }
      ]
    ],
    "scheme": "servant",
    "experiments": {
      "typedRoutes": false
    }
  }
}
